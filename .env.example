# SKYNET4 Owner
# This is a personal instance. Keep this as the Firebase account email of the owner.
OWNER_EMAIL=mcaluissa@gmail.com

# Gemini Configuration (Server-side only)
GEMINI_API_KEY=

# Firebase API verification (server-side; client may also expose the VITE_ form)
FIREBASE_API_KEY=

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Configuration (Server-side only)
# IMPORTANT: Use a Stripe Secret Key (starts with sk_test_ or sk_live_)
# DO NOT use a Google API Key (AIza...) here.
STRIPE_SECRET_KEY=

# GitHub Integration
# Crie um Personal Access Token em https://github.com/settings/tokens
GITHUB_PAT=
