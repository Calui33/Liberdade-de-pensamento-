{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user metadata and neural credits.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "credits": { "type": "number", "description": "Available neural credits for operations." },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "credits", "role"]
    },
    "Chat": {
      "title": "Chat History",
      "description": "Stores conversation history for each user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "text": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "messages"]
    },
    "Video": {
      "title": "Generated Video",
      "description": "Stores metadata for videos generated by the user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "prompt": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "prompt", "url"]
    },
    "Image": {
      "title": "Generated Image",
      "description": "Stores base64 image data separately to avoid chat document size limits.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "prompt": { "type": "string" },
        "data": { "type": "string", "description": "Base64 image data." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "data"]
    },
    "MapNode": {
      "title": "Neural Map Node",
      "description": "Stores locations discovered by the user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "uri": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "uri"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "User conversation logs."
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "User generated videos."
    },
    "/images/{imageId}": {
      "schema": "Image",
      "description": "User generated images (base64)."
    },
    "/map_nodes/{nodeId}": {
      "schema": "MapNode",
      "description": "Discovered neural nodes."
    }
  }
}
